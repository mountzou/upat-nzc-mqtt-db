# Copy once to /etc/upat-nzc/pv-ingestor.env, fill it interactively on the
# production host, and keep it owned by root with mode 0600. Never commit the
# populated file.
FUSIONSOLAR_BASE_URL=https://eu5.fusionsolar.huawei.com/thirdData
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_SYSTEM_CODE=
FUSIONSOLAR_PLANT_CODE=

# Use the internal Compose network endpoint, not the host-published port.
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
