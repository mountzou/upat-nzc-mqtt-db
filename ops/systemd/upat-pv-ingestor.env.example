# Copy once to /etc/upat-nzc/pv-ingestor.env, fill it interactively on the
# production host, and keep it owned by root with mode 0600. Never commit the
# populated file.
# Docker --env-file syntax: literal, unquoted KEY=value; no shell expansion.
# The new launcher requires a separately validated image containing api_control.
# Leave these empty until the deployment review; never reuse the old image.
PV_INGESTOR_IMAGE=
# Exact Git revision of the tested release; source hashes remain accepted for
# historical snapshots. Commit source before building future release images.
PV_INGESTOR_CODE_VERSION=

FUSIONSOLAR_BASE_URL=https://eu5.fusionsolar.huawei.com/thirdData
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_SYSTEM_CODE=
FUSIONSOLAR_PLANT_CODE=

# Use the internal Compose network endpoint, not the host-published port.
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
