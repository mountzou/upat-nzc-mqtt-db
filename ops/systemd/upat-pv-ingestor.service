[Unit]
Description=Collect and persist UPAT FusionSolar telemetry
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Restart=no
TimeoutStartSec=20min
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upat-pv-ingestor

# The shared launcher requires a validated digest in the private environment
# file and binds the same API ledger for scheduled and manual/backfill runs.
# Installing this template alone does not install or initialize that ledger.
ExecStart=/usr/local/sbin/upat-pv-ingestor scheduled

# If systemd stops or times out the attached Docker client, remove only this
# job's fixed-name container. A normally completed --rm run is already absent.
ExecStopPost=-/usr/bin/docker rm --force upat-pv-ingestor-scheduled

# Harden the host-side Docker client. The container has its own controls above.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
