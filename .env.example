# PV prediction
# Optional legacy metadata; the current Random Forest does not use these for inference.
PV_LATEST_ACTIVE_POWER_KW=
PV_LAG_1H_KW=
# Active inference and persistence controls.
PV_NIGHT_GHI_THRESHOLD_WM2=20.0
PV_SAVE_TO_DB=true

# FusionSolar PV ingestor preview (read-only; values must remain private)
FUSIONSOLAR_BASE_URL=
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_SYSTEM_CODE=
FUSIONSOLAR_PLANT_CODE=
FUSIONSOLAR_LOOKBACK_DAYS=3
FUSIONSOLAR_INCLUDE_METER=true

# Open-Meteo weather collector
OPEN_METEO_LATITUDE=37.068
OPEN_METEO_LONGITUDE=22.026
OPEN_METEO_TIMEZONE=Europe/Athens
OPEN_METEO_WIND_SPEED_UNIT=ms
OPEN_METEO_FORECAST_DAYS=8

# Simulation recorder
SIMULATION_API_USERNAME=
SIMULATION_API_PASSWORD=
SIMULATION_SCHOOL_IDS=school_3,school_7,school_10,school_13,school_22,school_23
SIMULATION_REQUEST_RETRIES=5
