[Unit]
Description=Collect and persist UPAT FusionSolar telemetry
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Restart=no
TimeoutStartSec=20min
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upat-collect-pv

# The shared launcher requires a validated digest in the private environment
# file and binds the shared API ledger for every collection.
# Installing this template alone does not install or initialize that ledger.
ExecStart=/usr/local/sbin/upat-collect-pv run

# If systemd stops or times out the attached Docker client, remove only this
# service invocation's container. A normally completed --rm run is already absent.
ExecStopPost=-/usr/bin/docker rm --force upat-collect-pv-${INVOCATION_ID}

# Harden the host-side Docker client. The container has its own controls above.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
