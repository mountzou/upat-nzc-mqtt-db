telemetry.schoolheroz.com {
	handle /ops/telemetry {
		reverse_proxy api:8000
	}

	@pv_data_service {
		method GET
		path /pv/readings /pv/readings/bounds /pv/day-ahead/range
	}

	handle @pv_data_service {
		reverse_proxy api:8000
	}

	@auth_read_service {
		method POST
		path /internal/auth/verify /internal/auth/resolve /internal/auth/session
	}

	handle @auth_read_service {
		reverse_proxy api:8000
	}

	@auth_preferences_service {
		method PATCH
		path /internal/auth/preferences
	}

	handle @auth_preferences_service {
		reverse_proxy api:8000
	}

	@monitoring_public {
        path /auth/login /auth/me /auth/preferences /schools /rooms /energy/* /indoor_environment/* /thermal-comfort/*
    }
    handle @monitoring_public {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

	handle {
		respond "Not Found" 404
	}
}
