telemetry.schoolheroz.com {
	handle /ops/telemetry {
		reverse_proxy api:8000
	}

	@auth_read_service {
		method POST
		path /internal/auth/verify /internal/auth/resolve
	}

	handle @auth_read_service {
		reverse_proxy api:8000
	}

	@auth_preferences_service {
		method PATCH
		path /internal/auth/preferences
	}

	handle @auth_preferences_service {
		reverse_proxy api:8000
	}

	handle {
		respond "Not Found" 404
	}
}
